# Normalize text files to LF in the repository; check out LF everywhere.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to run reliably.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly binary assets (no diff/merge, no EOL conversion).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.wasm binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
